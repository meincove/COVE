{
    "typo_tolerance": {
        "enabled": true,
        "edit_distance_threshold": 2,
        "min_word_length": 5,
        "apply_to_fields": [
            "type",
            "brand",
            "query"
        ],
        "algorithms": {
            "primary": "levenshtein",
            "fallback": "token_sort"
        }
    },
