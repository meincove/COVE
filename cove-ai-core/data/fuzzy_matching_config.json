    "brand_pattern_rules": {
        "remove_spaces_between_brand_product": true,
        "split_camelcase": true,
        "case_insensitive": true,
        "max_brand_word_length": 2,
        "description": "Rules for parsing brands from queries like 'COVEhoodie'"
    },
    "preprocessing": {
        "lowercase": true,
        "remove_extra_whitespace": true,
        "remove_punctuation": false
    }
}