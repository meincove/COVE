            "suit"
        ],
        "suits": [
            "suits"
        ],
        "tuxedo": [
            "tuxedo"
        ],
        "hoodie": [
            "hodie",
            "hoddie",
            "hoodee",
            "hudie"
        ],
        "jacket": [
            "jackett",
            "jaket",
            "jakket"
        ],
        "tee": [
            "te",
            "teee",
            "teeee"
        ],
        "sweater": [
            "swetr",
            "sweatr",
            "sweter"
        ],
        "shirt": [
            "shrt",
            "shrts"
        ],
        "bomber": [
            "bommer",
            "bombar"
        ],
        "pants": [
            "pant",
            "pnts"
        ],
        "jeans": [
