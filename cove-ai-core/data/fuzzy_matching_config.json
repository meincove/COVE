            "timelessco",
            "timeless co"
        ],
        "NordicThread": [
            "nordicthread",
            "nordic thread"
        ],
        "StreetVibe": [
            "streetvibe",
            "street vibe"
        ],
        "FlexFit": [
            "flexfit",
            "flex fit"
        ],
        "ComfortZone": [
            "comfortzone",
            "comfort zone"
        ],
        "FreeSpirit": [
            "freespirit",
