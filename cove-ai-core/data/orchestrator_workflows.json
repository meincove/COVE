{
    "outfit_builder": {
        "name": "Outfit Builder",
        "description": "Build complete outfit recommendations with Stylist, Fit, and Budget agents",
        "trigger_patterns": [
            "build me a",
            "build an outfit for",
            "create an outfit for",
            "outfit for my"
        ],
        "steps": [
            {
                "agent": "stylist",
                "required": true,
                "timeout_ms": 15000,
                "parallel_group": 0,
                "description": "Select outfit items based on occasion and style"
            },
            {
                "agent": "fit",
                "required": false,
                "timeout_ms": 2000,
                "parallel_group": 1,
                "description": "Recommend sizes for selected items"
            },
            {
                "agent": "budget",
                "required": true,
                "timeout_ms": 3000,
                "parallel_group": 1,
                "description": "Optimize pricing and apply discounts"
            }
        ],
        "min_success_agents": 2,
        "enable_checkpointing": true,
        "max_retries": 2,
        "observability": {
            "track_metrics": true,
            "log_state_transitions": true,
            "log_agent_timings": true
        }
    },
    "knowledge_query": {
        "name": "Knowledge Assistant",
        "description": "Answer usage or fashion concept questions",
        "steps": [
            {
                "agent": "knowledge",
                "required": true,
                "timeout_ms": 10000,
                "description": "Consult fashion knowledge base"
            }
        ],
        "min_success_agents": 1,
        "enable_checkpointing": false,
        "observability": {
            "track_metrics": true
        }
    },
    "support_request": {
        "name": "Support Assistant",
        "description": "Handle customer service requests",
        "steps": [
            {
                "agent": "support",
                "required": true,
                "timeout_ms": 5000,
                "description": "Execute support rules"
            }
        ],
        "min_success_agents": 1,
        "enable_checkpointing": false,
        "observability": {
            "track_metrics": true
        }
    }
}