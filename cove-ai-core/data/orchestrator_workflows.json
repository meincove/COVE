{
    "outfit_builder": {
        "name": "Outfit Builder",
        "description": "Build complete outfit recommendations with Stylist, Fit, and Budget agents",
        "trigger_patterns": [
            "outfit"
        ],
        "steps": [
            {
                "agent": "stylist",
                "required": true,
                "timeout_ms": 60000,
                "parallel_group": 0,
                "description": "Analyze request & plan outfit"
            },
            {
                "agent": "outfit_builder",
                "required": true,
                "timeout_ms": 90000,
                "parallel_group": 1,
                "description": "Assemble outfit from candidates"
            },
            {
                "agent": "fit",
                "required": false,
                "timeout_ms": 2000,
                "parallel_group": 2,
                "description": "Recommend sizes for selected items"
            },
            {
                "agent": "budget",
                "required": true,
                "timeout_ms": 3000,
                "parallel_group": 2,
                "description": "Optimize pricing and apply discounts"
            }
        ],
        "min_success_agents": 2,
        "enable_checkpointing": true,
        "max_retries": 2,
        "observability": {
            "track_metrics": true,
            "log_state_transitions": true,
            "log_agent_timings": true
        }
    },
    "knowledge_query": {
        "name": "Knowledge Assistant",
        "description": "Answer usage or fashion concept questions",
        "steps": [
            {
                "agent": "knowledge",
                "required": true,
                "timeout_ms": 10000,
                "description": "Consult fashion knowledge base"
            }
        ],
        "min_success_agents": 1,
        "enable_checkpointing": false,
        "observability": {
            "track_metrics": true
        }
    },
    "support_request": {
        "name": "Support Assistant",
        "description": "Handle customer service requests",
        "steps": [
            {
                "agent": "support",
                "required": true,
                "timeout_ms": 5000,
                "description": "Execute support rules"
            }
        ],
        "min_success_agents": 1,
        "enable_checkpointing": false,
        "observability": {
            "track_metrics": true
        }
    },
    "multimodal_search": {
        "name": "Visual Search Assistant",
        "description": "Search products using uploaded images or style references",
        "trigger_patterns": [
            "search by image",
            "upload",
            "looks like this",
            "find this"
        ],
        "steps": [
            {
                "agent": "fashion_analyzer",
                "required": true,
                "timeout_ms": 30000,
                "parallel_group": 0,
                "description": "Extract Fashion DNA from image"
            },
            {
                "agent": "stylist",
                "required": true,
                "timeout_ms": 60000,
                "parallel_group": 1,
                "description": "Find products matching visual DNA"
            }
        ],
        "min_success_agents": 2,
        "enable_checkpointing": true,
        "observability": {
            "track_metrics": true
        }
    }
}